# =================
# PRODUÇÃO — TEMPLATE
# =================
# Copiar este arquivo para .env.production
# Substituir XXX pelas suas chaves REAIS

# === MONGODB ===
# Obter em: https://www.mongodb.com/cloud/atlas (cluster M0 gratuito)
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/besord?retryWrites=true&w=majority

# === STRIPE (MODO LIVE) ===
# Obter em: https://dashboard.stripe.com/apikeys
# Use a sua chave real do Stripe Live aqui:
STRIPE_API_KEY=<stripe_live_key>

# Webhook secret para validação de eventos Stripe
# Obter em: https://dashboard.stripe.com/webhooks depois de registar endpoint
STRIPE_WEBHOOK_SECRET=<stripe_webhook_secret>

# === RESEND (Email Service) ===
# Obter em: https://resend.com/api-keys
RESEND_API_KEY=re_XXXxxxXXXxxxXXXxxxXXXxxx

# Email de origem (mude para seu domínio depois)
EMAIL_FROM=noreply@besord.eu

# === FRONTEND ===
# URL onde o frontend está hospedado (Vercel)
FRONTEND_BASE_URL=https://besord.vercel.app

# === AUTHENTICATION ===
# Gere uma chave segura: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=XXXxxxXXXxxxXXXxxxXXXxxxXXXxxxXXXxxxXXXxxxXXXxxx

# === OAUTH (Opcional) ===
# Google: https://console.cloud.google.com
GOOGLE_CLIENT_ID=XXXxxxXXXxxxXXXxxxXXXxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=XXXxxxXXXxxxXXXxxxXXXxxx

# Apple: https://developer.apple.com/account
APPLE_CLIENT_ID=com.besord.app
APPLE_CLIENT_SECRET=XXXxxxXXXxxxXXXxxxXXXxxx

# === LOGGING & DEBUG ===
LOG_LEVEL=info
DEBUG=false

# === DATABASE BACKUP (Opcional) ===
# Você pode adicionar cron jobs para backup automático
BACKUP_ENABLED=false
