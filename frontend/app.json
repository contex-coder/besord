{
  "expo": {
    "name": "Besord",
    "slug": "besord",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/NewBesord.png",
    "scheme": "besord",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Selecione fotos para criar posts no Besord"
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "package": "com.besord.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/NewBesord.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ],
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/NewBesord.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/NewBesord.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "83893be0-ae4d-43a8-837d-dbd441193fef"
      }
    },
    "owner": "besord",
    "updates": {
      "url": "https://u.expo.dev/83893be0-ae4d-43a8-837d-dbd441193fef"
    }
  }
}
